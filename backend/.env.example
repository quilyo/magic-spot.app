# ─── Camera ───────────────────────────────────────────────
CAM_IP=192.168.1.110
CAM_PORT=80
CAM_USERNAME=admin
CAM_PASSWORD=your_camera_password
RTSP_URL=rtsp://192.168.1.110:554/stream0?username=admin&password=YOUR_RTSP_PASSWORD
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
PTZ_MOVE_WAIT=10

# ─── Roboflow ─────────────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_MODEL_ID=modelv4-vpdmq/1
ROBOFLOW_API_URL=https://detect.roboflow.com
CONFIDENCE_THRESHOLD=0.20
GEOFENCE_BOX_SCALE=0.30
GEOFENCE_BOX_SHRINK=0
ROBOFLOW_MAX_RETRIES=3

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key
SUPABASE_TABLE=parking_status

# ─── Cycle ────────────────────────────────────────────────
SNAPSHOT_INTERVAL=120
